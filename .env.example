# KidBoard 环境变量示例 — 复制为 .env 后按需修改；.env 不进入 git
# 供 infra/docker-compose.yml 与 packages/db 工具（drizzle-kit）使用。

# --- 数据库（与 infra/docker-compose.yml 的 postgres 服务保持一致）---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kidboard
POSTGRES_USER=kidboard
POSTGRES_PASSWORD=kidboard

# 完整连接串（drizzle-kit 与 apps 使用这一条）
DATABASE_URL=postgresql://kidboard:kidboard@localhost:5432/kidboard

# --- 宿主机端口映射（本机端口被占用时改这里）---
# 3000/5432 被占用时，例如改为 WEB_PORT=3100、POSTGRES_PORT=5433
WEB_PORT=3000
# POSTGRES_PORT=5432

# --- Web ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Renderer（Phase 3 启用）---
FRAMES_DIR=/data/frames
RENDERER_PORT=3001

# --- Docker Compose ---
COMPOSE_PROJECT_NAME=kidboard

# --- 安全（必填）：设备 token 派生与看板凭证 HMAC 密钥；留空会退回代码内置默认值，不安全 ---
# 生成示例：openssl rand -hex 32
SESSION_SECRET=

# --- 和风天气（可选，D-013）：不配则屏幕不显示天气 ---
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# --- Renderer 调优（可选）---
# RENDER_THRESHOLD=160
# RENDERER_IDLE_MS=3000

# --- OTA 下发（可选，真机未验证；需先在 infra/docker-compose.yml 的 web 环境中加入这些变量）---
# KIDBOARD_OTA_VERSION=
# KIDBOARD_OTA_URL=
# KIDBOARD_OTA_SHA256=
# KIDBOARD_OTA_MANDATORY=false
