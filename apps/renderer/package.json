  },
  "devDependencies": {
    "@kidboard/tsconfig": "workspace:*",
    "@types/node": "22.20.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
